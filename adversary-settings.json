{
  "permissions": {
    "defaultMode": "plan",
    "deny": ["Write", "Edit", "NotebookEdit"]
  },
  "crossSessionInbound": "accept",
  "autoMemoryEnabled": false,
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "strictAllowlist": true,
    "filesystem": {
      "denyWrite": ["/"]
    }
  }
}
